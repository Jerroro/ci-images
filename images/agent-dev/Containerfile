# Mutable stable tags are intentionally refreshed by build.sh. Each successful
# candidate records its resulting image ID and actual software versions.
ARG BASE_IMAGE=docker.io/library/ubuntu:24.04
ARG PYTHON_IMAGE=docker.io/library/python:3-slim-bookworm
ARG NODE_IMAGE=docker.io/library/node:current-bookworm-slim
ARG GO_IMAGE=docker.io/library/golang:bookworm
ARG RUST_IMAGE=docker.io/library/rust:slim-bookworm

FROM ${NODE_IMAGE} AS node-tools
# Programs live outside user state. Explicitly allow only the known lifecycle
# scripts needed to link their platform-specific executables.
RUN npm install --global --prefix /opt/agent-tools --no-audit --no-fund \
        --allow-scripts=opencode-ai,pnpm \
        @openai/codex@latest opencode-ai@latest pnpm@latest \
        typescript@latest eslint@latest prettier@latest pyright@latest \
        @yarnpkg/cli-dist@latest \
    && npm install --global --prefix /opt/agent-tools --no-audit --no-fund \
        --ignore-scripts @earendil-works/pi-coding-agent@latest \
    && npm install --global --prefix /opt/corepack-tools --no-audit --no-fund corepack@latest \
    && npm cache clean --force

FROM ${PYTHON_IMAGE} AS python-toolchain
# Project venvs stay separate. Preserve the original single-interpreter
# linters/test tools; isolate package-manager dependencies in their own venv.
# hadolint ignore=DL3013
RUN python -m pip install --no-cache-dir --disable-pip-version-check \
        ruff black mypy isort pytest cpplint cmakelang \
    && python -m venv /opt/python-tools \
    && /opt/python-tools/bin/python -m pip install \
        --no-cache-dir --disable-pip-version-check uv poetry pipx

FROM ${GO_IMAGE} AS go-toolchain
# hadolint ignore=DL3062
RUN CGO_ENABLED=0 GOTOOLCHAIN=local GOBIN=/opt/go-tools/bin \
        go install -p=4 github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest \
    && go version -m /opt/go-tools/bin/golangci-lint > /opt/go-tools/build-info.txt \
    && go clean -cache -modcache

FROM ${RUST_IMAGE} AS rust-toolchain
RUN rustup component add rustfmt clippy

# Keep the original distro family/version. Toolchain binaries built on older
# Debian libc must still be checked against this final Ubuntu userspace.
FROM ${BASE_IMAGE}
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_NO_PROGRESS=1 \
    COREPACK_DEFAULT_TO_LATEST=0 \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    COREPACK_ENABLE_AUTO_PIN=0 \
    COREPACK_ENABLE_STRICT=0 \
    GOROOT=/opt/go \
    GOPATH=/root/go \
    GOTOOLCHAIN=local \
    RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/root/.cargo \
    PATH=/opt/agent-tools/bin:/opt/go-tools/bin:/opt/node/bin:/opt/go/bin:/opt/rust/bin:/usr/local/bin:/root/.local/bin:/root/.cargo/bin:/root/go/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin

# Upgrade/install/cleanup share one layer. Python runtime libraries cover the
# official /usr/local Python closure; apt may keep its own system interpreter
# for OS tools, but there is only one selected development Python.
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
        bash build-essential ca-certificates ccache clang clang-format clang-tidy \
        cmake curl fd-find ffmpeg fontconfig fonts-noto-cjk gawk gettext \
        git git-lfs gnupg inotify-tools iputils-ping jq \
        libbz2-dev libcurl4-openssl-dev libdb-dev libexpat1 libffi-dev \
        libgdbm-compat4t64 libgdbm-dev libjpeg-dev liblzma-dev libncursesw6 \
        libpng-dev libpq-dev libreadline-dev libsqlite3-dev libssl-dev \
        libuuid1 libxml2-dev libxslt1-dev libyaml-dev libzip-dev libzstd1 \
        nano nasm netcat-openbsd ninja-build openssh-server openssh-sftp-server \
        pkg-config procps protobuf-compiler ripgrep rsync sqlite3 sudo swig \
        tini tmux universal-ctags unzip wget xz-utils yasm zip zlib1g-dev \
        bind9-dnsutils \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/ssh/ssh_host_* \
    && fc-cache -f

COPY --from=python-toolchain /usr/local/ /usr/local/
COPY --from=python-toolchain /opt/python-tools/ /opt/python-tools/
COPY --from=node-tools /usr/local/bin/node /opt/node/bin/node
COPY --from=node-tools /usr/local/lib/node_modules/npm/ /opt/node/lib/node_modules/npm/
COPY --from=node-tools /opt/agent-tools/ /opt/agent-tools/
COPY --from=node-tools /opt/corepack-tools/ /opt/corepack-tools/
COPY --from=go-toolchain /usr/local/go/ /opt/go/
COPY --from=go-toolchain /opt/go-tools/ /opt/go-tools/
COPY --from=rust-toolchain /usr/local/rustup/ /opt/rustup/
COPY --from=rust-toolchain /usr/local/cargo/bin/ /opt/rust/bin/

RUN ldconfig \
    && ln -s ../lib/node_modules/npm/bin/npm-cli.js /opt/node/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /opt/node/bin/npx

# Official CLI installer verifies the native payload against its SHA512 manifest.
# Its shell setup uses a disposable HOME; no user state enters the image.
RUN mkdir -p /tmp/antigravity-install \
    && curl --fail --silent --show-error --location \
        https://antigravity.google/cli/install.sh -o /tmp/antigravity-install/install.sh \
    && HOME=/tmp/antigravity-install bash /tmp/antigravity-install/install.sh \
        --dir /opt/antigravity/bin \
    && rm -rf /tmp/antigravity-install

COPY scripts/ /usr/local/libexec/agent-container/
COPY sshd_config /etc/ssh/sshd_config
# Generate profile/PAM environment AND default-PATH wrappers. Wrappers are
# needed even with UsePAM=no or a host-mounted sshd_config that ignores ENV.
RUN chmod 0755 /usr/local/libexec/agent-container/*.sh \
    && python /usr/local/libexec/agent-container/configure-environment.py \
    && mkdir -p /tmp/version-check-home \
    && HOME=/tmp/version-check-home \
       XDG_CONFIG_HOME=/tmp/version-check-home/.config \
       XDG_CACHE_HOME=/tmp/version-check-home/.cache \
       XDG_DATA_HOME=/tmp/version-check-home/.local/share \
       python /usr/local/libexec/agent-container/versions.py \
        > /usr/local/share/agent-container-versions.json \
    && rm -rf /tmp/version-check-home

WORKDIR /workspace
EXPOSE 22
# No VOLUME directives: persistence is explicitly chosen by the deployment.
# No runtime installer, automatic update, host key generation, or sleep infinity.
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/libexec/agent-container/entrypoint.sh"]
CMD ["/usr/sbin/sshd", "-D", "-e"]
